# Supabase project Settings > Database > Connection string (PostgreSQL)
DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# Google OAuth 2.0 Web client ID. The same ID is used by the browser and server verifier.
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# Gmail App Password used to send password recovery email (server only)
SMTP_USER="help.bekubazar@gmail.com"
SMTP_APP_PASSWORD="your-gmail-app-password"

# Comma-separated email addresses allowed to access shipment administration
ADMIN_EMAILS=operations@example.com

# Public site domain used for metadata and sitemap URLs (without protocol)
DOMAIN=ssbanglaexpress.com
