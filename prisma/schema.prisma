generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum QuoteStatus {
  NEW
  REVIEWING
  QUOTED
  ACCEPTED
  DECLINED
  CONVERTED
  CLOSED
}

enum ShipmentStatus {
  BOOKED
  PICKUP_SCHEDULED
  PICKED_UP
  IN_TRANSIT
  CUSTOMS_CLEARANCE
  OUT_FOR_DELIVERY
  DELIVERED
  ON_HOLD
  CANCELLED
  EXCEPTION
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

enum MessageRole {
  CUSTOMER
  SUPPORT
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  avatarUrl           String?
  passwordHash        String?
  googleId            String?              @unique
  role                UserRole             @default(USER)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            UserSession[]
  passwordResetTokens PasswordResetToken[]
  addresses           Address[]
  quoteRequests       QuoteRequest[]
  shipments           Shipment[]

  chatParticipants ChatParticipant[]

  chats Chat[] @relation("ChatCreator")

  messages Message[] @relation("MessageSender")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserSession {
  id        String    @id
  userId    String
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model QuoteRequest {
  id          String      @id
  type        String
  receivedAt  DateTime    @default(now())
  fullName    String
  email       String
  phone       String
  origin      String
  destination String
  itemType    String
  weight      String
  cartons     String
  dimensions  String
  quantity    String
  sizeRange   String
  material    String
  targetPrice String
  details     String
  status      QuoteStatus @default(NEW)
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  shipment    Shipment?

  @@index([status, receivedAt])
  @@index([userId, receivedAt])
}

model PublicRate {
  id             String   @id @default(cuid())
  origin         String
  destination    String
  service        String
  minWeightKg    Decimal  @db.Decimal(10, 2)
  maxWeightKg    Decimal? @db.Decimal(10, 2)
  amount         Decimal  @db.Decimal(12, 2)
  currency       String   @default("USD")
  notes          String   @default("")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([active, origin, destination, service, minWeightKg])
}

model ContactMessage {
  id         String   @id
  receivedAt DateTime @default(now())
  firstName  String
  lastName   String
  email      String
  phone      String
  message    String
}

model Address {
  id           String     @id @default(cuid())
  userId       String
  label        String?
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String?
  country      String
  isDefault    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderFor    Shipment[] @relation("ShipmentSenderAddress")
  recipientFor Shipment[] @relation("ShipmentRecipientAddress")

  @@index([userId])
}

model Shipment {
  id                  String          @id @default(cuid())
  trackingNumber      String          @unique
  userId              String?
  customerName        String          @default("")
  customerEmail       String          @default("")
  customerPhone       String          @default("")
  quoteRequestId      String?         @unique
  senderAddressId     String?
  recipientAddressId  String?
  serviceType         String
  status              ShipmentStatus  @default(BOOKED)
  origin              String
  destination         String
  pickupAddress       String          @default("")
  deliveryAddress     String          @default("")
  productType         String          @default("")
  packageDescription  String          @default("")
  cartons             Int             @default(1)
  specialInstructions String          @default("")
  weight              Decimal?        @db.Decimal(10, 2)
  weightUnit          String          @default("kg")
  currency            String          @default("BDT")
  quotedAmount        Decimal?        @db.Decimal(12, 2)
  bookedAt            DateTime        @default(now())
  estimatedDelivery   DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  user                User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  quoteRequest        QuoteRequest?   @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)
  senderAddress       Address?        @relation("ShipmentSenderAddress", fields: [senderAddressId], references: [id], onDelete: SetNull)
  recipientAddress    Address?        @relation("ShipmentRecipientAddress", fields: [recipientAddressId], references: [id], onDelete: SetNull)
  trackingEvents      ShipmentEvent[]
  payments            PaymentRecord[]

  @@index([userId, bookedAt])
  @@index([status, updatedAt])
}

model ShipmentEvent {
  id          String         @id @default(cuid())
  shipmentId  String
  status      ShipmentStatus
  description String
  location    String?
  occurredAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
}

model PaymentRecord {
  id                String        @id @default(cuid())
  shipmentId        String
  provider          String
  providerReference String?       @unique
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("BDT")
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  shipment          Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, createdAt])
  @@index([status, createdAt])
}

model Chat {
  id            String    @id @default(cuid())
  subject       String?
  createdById   String?
  guestName     String?
  guestEmail    String?
  guestPhone    String?
  guestTokenHash String?  @unique
  contextType   String?
  contextReference String?
  botState      Json?
  lastMessageId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  closedAt      DateTime?

  createdBy    User?             @relation("ChatCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants ChatParticipant[]
  messages     Message[]
  lastMessage  Message?          @relation("ChatLastMessage", fields: [lastMessageId], references: [id], onDelete: SetNull)

  @@index([createdById, updatedAt])
  @@index([lastMessageId])
  @@index([guestEmail, updatedAt])
}

model ChatParticipant {
  id         String    @id @default(cuid())
  chatId     String
  userId     String
  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?
  mutedAt    DateTime?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId, archivedAt, updatedAt])
  @@index([chatId, joinedAt])
}

model Message {
  id        String    @id @default(cuid())
  chatId    String
  senderId  String?
  role      MessageRole @default(CUSTOMER)
  replyToId String?
  imageId   String?
  content   String?   @db.Text
  data      Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime?
  deletedAt DateTime?

  chat    Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender  User?     @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  replyTo Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies Message[] @relation("MessageReplies")
  chats   Chat[]    @relation("ChatLastMessage")

  @@index([chatId, createdAt, id])
  @@index([senderId, createdAt])
  @@index([replyToId])
}

model EmailJob {
  id        String    @id
  type      String
  payload   Json
  status    String    @default("PENDING")
  attempts  Int       @default(0)
  runAt     DateTime  @default(now()) @db.Timestamptz(6)
  lockedAt  DateTime? @db.Timestamptz(6)
  sentAt    DateTime? @db.Timestamptz(6)
  lastError String?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @db.Timestamptz(6)

  @@index([status, runAt])
  @@index([status, lockedAt])
}
